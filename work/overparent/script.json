  "lines": [
    {
      "text": "요즘 부모들이 애를 못 놓는 이유?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "놀이터 가보면 바로 보임.",
      "img": 1
    },
    {
      "text": "애가 미끄럼틀 올라가는데",
      "img": 2
    },
    {
      "text": "부모가 계단마다 손을 받치고 따라감.",
      "img": 2
    },
    {
      "text": "예전 같으면 그냥 뒀을 높이임.",
      "img": 3
    },
    {
      "text": "근데 이걸 유난이라고만 보기가 좀 그럼.",
      "img": 3
    },
    {
      "text": "부모가 겁이 많아진 게 아니라",
      "img": 4
    },
    {
      "text": "애가 한 명뿐이라 그런 거임.",
      "emotion": "tonedown",
      "img": 4
    },
    {
      "text": "형제가 넷이던 시절엔",
      "img": 5
    },
    {
      "text": "한 명이 넘어져도 나머지가 있었음.",
      "img": 5
    },
    {
      "text": "지금은 그 한 명이 전부임.",
      "emotion": "tonedown",
      "img": 6
    },
    {
      "text": "그러니까 실패가 연습이 아니라 사고가 됨.",
      "img": 6
    },
    {
      "text": "여기에 정보가 하나 더 얹힘.",
      "emotion": "toneup",
      "img": 7
    },
    {
      "text": "예전엔 사고가 나도 동네 얘기로 끝났는데",
      "img": 7
    },
    {
      "text": "지금은 전국 사고가 실시간으로 들어옴.",
      "img": 8
    },
    {
      "text": "그래서 체감 위험이 계속 올라감.",
      "emotion": "tonedown",
      "img": 8
    },
    {
      "text": "결국 과보호는 성격 문제가 아니라",
      "img": 9
    },
    {
      "text": "애가 줄고 정보가 늘어난 결과임.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "부모가 유난해진 게 아니라",
      "emotion": "tonedown",
      "img": 10
    },
    {
      "text": "잃을 게 하나밖에 안 남은 거임.",
      "emotion": "tonedown",
      "img": 10
    }
  ]
}