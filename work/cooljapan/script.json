  },
  "lines": [
    {
      "text": "일본이 4,779억 태울 때 한국이 한 것?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "2013년에 일본 정부가 펀드를 하나 만들었음.",
      "img": 1
    },
    {
      "text": "일본 만화랑 드라마랑 음식을 해외에 팔아보자는 거였음.",
      "img": 2
    },
    {
      "text": "정부가 직접 돈을 넣고 사업도 골랐음.",
      "img": 2
    },
    {
      "text": "근데 13년이 지난 지금",
      "img": 3
    },
    {
      "text": "이 펀드를 없애기로 했음.",
      "emotion": "tonedown",
      "img": 3
    },
    {
      "text": "이게 쿨재팬 기구임.",
      "emotion": "tonedown",
      "img": 4
    },
    {
      "text": "쌓인 적자가 540억엔.",
      "img": 4
    },
    {
      "text": "우리 돈으로 약 4,779억원임.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "일본 관계자가 이유를 이렇게 말했음.",
      "img": 5
    },
    {
      "text": "돈 될 사업은 이미 민간이 갖고 있었음!",
      "dialogue": true,
      "img": 6
    },
    {
      "text": "정부가 고를 수 있는 건 민간이 안 건드린 것들이었단 뜻임.",
      "emotion": "tonedown",
      "img": 6
    },
    {
      "text": "근데 같은 기간에 한국은 정반대로 갔음.",
      "emotion": "toneup",
      "img": 8
    },
    {
      "text": "정부가 고르는 대신 민간이 먼저 만들었음.",
      "img": 8
    },
    {
      "text": "아이돌도 드라마도 게임도 회사들이 알아서 뚫었고",
      "img": 9
    },
    {
      "text": "정부는 판을 까는 쪽에 있었음.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "그 결과가 숫자로 나왔음.",
      "emotion": "toneup",
      "img": 10
    },
    {
      "text": "2024년 콘텐츠 수출이 140억 달러를 넘었음.",
      "img": 10
    },
    {
      "text": "게임만 85억 달러, 음악이 18억 달러임.",
      "img": 11
    },
    {
      "text": "한쪽은 정부가 앞장서다 4,779억을 태웠고",
      "emotion": "tonedown",
      "img": 11
    },
    {
      "text": "한쪽은 민간이 앞장서서 140억 달러를 벌었음.",
      "emotion": "tonedown",
      "img": 12
    },
    {
      "text": "돈을 누가 냈냐가 아니라 누가 골랐냐에서 갈린 거임.",
      "emotion": "tonedown",
      "img": 12
    }
  ]
}