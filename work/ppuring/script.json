  "lines": [
    { "text": "일본인이 한국 음식 하나 먹고 완전 개화해버린 글이 화제임.", "img": 1 },
    { "text": "그 음식이 뭐냐면 바로 뿌링클 치킨임.", "em": ["뿌링클 치킨"], "img": 2 },
    { "text": "치즈랑 어니언 파우더가 잔뜩 묻은 그 노란 치킨 맞음.", "img": 2 },
    { "text": "여기에 치즈볼까지 같이 시켰는데", "img": 3 },
    { "text": "한 입 먹더니 이 사람이 한 말이 웃김.", "img": 4 },
    { "text": "대한민국, 이런 걸 국민식으로 허용해도 되는 건가.", "dialogue": true, "img": 4 },
    { "text": "지금 당장 유네스코 무형문화유산에 등록하라고.", "dialogue": true, "img": 5 },
    { "text": "치킨 하나에 나라 문화유산까지 소환한 거임.", "img": 6 },
    { "text": "근데 댓글 반응이 더 웃긴 게", "img": 7 },
    { "text": "한국인들은 10년 넘게 먹어서 이제 지겹다는 거임.", "em": ["지겹다"], "em_color": "yellow", "img": 8 },
    { "text": "남들 눈엔 문화유산인데 우리한텐 그냥 야식인 거임.", "img": 9 },
    { "text": "님들은 아직도 뿌링클 시킴?", "img": 10 },
    { "text": "구독!", "emotion": "toneup", "intensity": 2.0, "outro": true }
