  "lines": [
    {
      "text": "생리 전에 유독 예민해지는 진짜 이유?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "본인도 알고 있음.",
      "img": 1
    },
    {
      "text": "별것도 아닌 말에 확 올라옴.",
      "img": 2
    },
    {
      "text": "그리고 지나고 나면 왜 그랬지 싶음.",
      "emotion": "tonedown",
      "img": 2
    },
    {
      "text": "이걸 성격 문제로 보는 사람이 많은데",
      "img": 3
    },
    {
      "text": "몸에서 일어나는 일임.",
      "emotion": "tonedown",
      "img": 3
    },
    {
      "text": "생리 시작하기 전 일주일쯤",
      "img": 4
    },
    {
      "text": "여성호르몬 수치가 급격하게 떨어짐.",
      "img": 4
    },
    {
      "text": "문제는 이 호르몬이 기분에도 관여한다는 거임.",
      "emotion": "toneup",
      "img": 5
    },
    {
      "text": "감정을 안정시키는 물질이 같이 흔들림.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "그래서 평소랑 같은 자극인데",
      "img": 6
    },
    {
      "text": "받아치는 힘만 약해져 있음.",
      "emotion": "tonedown",
      "img": 6
    },
    {
      "text": "이걸 월경 전 증후군이라고 하는데.",
      "emotion": "tonedown",
      "img": 7
    },
    {
      "text": "가벼운 정도는 아주 흔함.",
      "img": 7
    },
    {
      "text": "일상이 무너질 만큼 심한 경우는 따로 진단명이 있음.",
      "img": 8
    },
    {
      "text": "그러니까 참으라고 할 일이 아님.",
      "emotion": "toneup",
      "img": 8
    },
    {
      "text": "예민해진 게 아니라",
      "img": 9
    },
    {
      "text": "버틸 힘이 잠깐 줄어든 거임.",
      "emotion": "tonedown",
      "img": 9
    }
  ]
