{
  "slug": "fourth",
  "type": "커뮤니티/방송 소재 — 본문 충실",
  "title_line1": "39살 아내가 자꾸",
  "title_line2": "넷째 낳자고 함ㄷㄷ",
  "hook": "39살 아내가 자꾸 넷째 낳자고 함ㄷㄷ",
  "channel": "썰푸는휴지",
  "voice": "main",
  "source": "https://www.dogdrip.net/721500144",
  "style": { "sub_box": true },
  "lines": [
    { "text": "방송에 부부가 나와서 고민을 털어놨는데, 고민이 좀 특이했음.", "img": 1 },
    { "text": "아내가 너무 예쁜 게 고민입니다.", "dialogue": true, "voice": "sub2", "img": 1 },
    { "text": "남편은 첫째 둘째 셋째를 낳는 동안 정직하게 세월을 맞았는데,", "img": 2 },
    { "text": "아내는 혼자 세월을 역주행했다고 함.", "em": ["세월을 역주행"], "img": 2 },
    { "text": "아내 나이가 39살인데 기미도 주근깨도 없음.", "em": ["39살"], "em_color": "yellow", "img": 3 },
    { "text": "근데 진짜 문제는 얼굴이 아니었음.", "img": 4 },
    { "text": "아내가 자꾸 넷째를 낳자고 함.", "em": ["넷째"], "em_color": "yellow", "img": 4 },
    { "text": "저는 셋째까지만 잘 키우면 어떻겠냐, 이런 상황이에요.", "dialogue": true, "voice": "sub2", "img": 5 },
    { "text": "근데 아내는 넷째도 다섯째도 낳고 싶어함.", "em": ["다섯째"], "img": 5 },
    { "text": "셋을 줄줄이 낳느라 그때는 너무 힘들었는데,", "img": 6 },
    { "text": "지금은 셋 다 초등학생이 됐음. 4학년, 2학년, 1학년.", "em": ["초등학생"], "img": 7 },
    { "text": "아이들이 크고 나니까 여유가 돌아왔고,", "em": ["여유"], "img": 8 },
    { "text": "그러니까 아기들이 다시 예뻐 보이기 시작했다는 거임.", "em": ["다시 예뻐"], "emotion": "tonedown", "img": 9 },
    { "text": "저희 엄마도 3남매를 낳으셨어요.", "dialogue": true, "voice": "sub1", "img": 10 },
    { "text": "자기가 예쁘다는 소리를 듣는 것도,", "img": 11 },
    { "text": "오빠가 세 아이 키우는 걸 진짜 많이 도와줘서인 것 같아요.", "dialogue": true, "voice": "sub1", "img": 11 },
    { "text": "그래서 너무 고맙다고 해놓고는,", "img": 12 },
    { "text": "곧바로 넷째는 한번 어떠냐고 다시 밀어붙임.", "em": ["넷째는 한번"], "em_color": "yellow", "img": 12 },
    { "text": "옆에서 듣던 사람도 낳으라 마라 할 수는 없다고 했음.", "img": 13 },
    { "text": "셋 키우느라 잃었던 여유가 돌아오니까 넷째가 보이는 거.", "em": ["여유가 돌아오니까"], "emotion": "tonedown", "img": 13 },
    { "text": "이 집은 넷째까지 가는 게 맞을까?", "img": 13 },
    { "text": "구독", "outro": true }
  ]
}
