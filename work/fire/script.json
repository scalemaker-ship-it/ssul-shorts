{
  "slug": "fire",
  "type": "감동·현장 (한국)",
  "source": "https://www.newsis.com/view/NISX20190405_0000610752",
  "title_line1": "반나절 만에 모인",
  "title_line2": "소방차 872대",
  "hook": "반나절 만에 모인 소방차 872대",
  "channel": "썰푸는휴지",
  "voice": "main",
  "style": {
    "sub_box": true
  },
  "lines": [
    {
      "text": "2019년 4월 4일 밤, 소방차 872대가 강원도로 달렸음.",
      "em": [
        "872대"
      ],
      "em_color": "yellow",
      "img": 1
    },
    {
      "text": "고성에서 난 불이 바람을 타고 속초 시내까지 들어왔음.",
      "img": 2
    },
    {
      "text": "초속 30미터 강풍이라 불이 도로를 건너뛰었음.",
      "img": 2
    },
    {
      "text": "시내까지 불이 오면 어떻게 막음?",
      "dialogue": true,
      "img": 3
    },
    {
      "text": "그날 밤 전국에 소방동원령이 떨어졌음.",
      "img": 4
    },
    {
      "text": "서울, 경기, 전남, 경남에서 소방차가 고속도로를 타고 올라왔고",
      "img": 5
    },
    {
      "text": "반나절 만에 872대, 소방관 3,251명이 모였음.",
      "em": [
        "3,251명"
      ],
      "img": 5
    },
    {
      "text": "고속도로가 소방차 행렬로 꽉 찬 사진이 그날 밤에 찍힘.",
      "img": 6
    },
    {
      "text": "단일 화재로는 역대 최다 동원이었음.",
      "img": 6
    },
    {
      "text": "결과는 불 난 지 21시간 만에 완전 진화.",
      "em": [
        "21시간"
      ],
      "em_color": "yellow",
      "img": 7
    },
    {
      "text": "소방관 사망 0명, 문화재 피해 0건.",
      "em": [
        "0명"
      ],
      "img": 7
    },
    {
      "text": "그날 고속도로 위 행렬을 본 사람들은 아직도 그 얘기를 함.",
      "emotion": "tonedown",
      "img": 8
    },
    {
      "text": "님들은 그 사진 봤음?",
      "img": 8
    },
    {
      "text": "구독!",
      "emotion": "toneup",
      "intensity": 2.0,
      "outro": true
    }
  ]
}