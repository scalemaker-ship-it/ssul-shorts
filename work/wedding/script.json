  "style": { "sub_box": true },
  "lines": [
    { "text": "지인 결혼식에 축의금 20만원을 보냈음.", "em": ["20만원"], "img": 1 },
    { "text": "근데 계좌에 0을 하나 더 붙여버렸음.", "em": ["0을 하나 더"], "em_color": "yellow", "img": 2 },
    { "text": "200만원이 나간 거임.", "em": ["200만원"], "em_color": "yellow", "img": 2 },
    { "text": "그걸 이틀 뒤에 발견했고,", "em": ["이틀 뒤"], "img": 3 },
    { "text": "전화를 할까 말까 고민하다가 또 이틀이 지났음.", "em": ["또 이틀"], "img": 4 },
    { "text": "그 사이에 지인한테서 문자가 하나 왔는데,", "img": 5 },
    { "text": "잘못 보낸 거 맞제.", "dialogue": true, "voice": "sub2", "img": 5 },
    { "text": "180만원이 이미 도로 들어와 있었음.", "em": ["180만원"], "em_color": "yellow", "img": 6 },
    { "text": "문자에는 이런 말이 같이 붙어 있었음.", "img": 7 },
    { "text": "난 10년 전에 자네 장모님 돌아가셨을 때 5만원밖에 못 보냈는데,", "dialogue": true, "voice": "sub2", "img": 7 },
    { "text": "20만원이나 보내줘서 정말 고맙다.", "dialogue": true, "voice": "sub2", "img": 8 },
    { "text": "그러고는 180만원 4일치 예금 이자는 없다고 농담까지 붙였음.", "em": ["4일치 예금 이자"], "img": 9 },
    { "text": "4일치 이자면 실제로는 몇백 원 수준임.", "img": 10 },
    { "text": "근데 그 농담 한마디에 돈 얘기가 통째로 가벼워졌음.", "em": ["농담 한마디"], "img": 10 },
    { "text": "어차피 돌려받을 돈이었는데도,", "img": 11 },
    { "text": "내 돈이지만 그 마음이 더 고맙더라는 거.", "em": ["그 마음이"], "emotion": "tonedown", "img": 12 },
    { "text": "200만원 잘못 보냈을 때 이런 답 받을 자신 있음?", "img": 13 },
    { "text": "구독", "outro": true }
  ]
}
