  "lines": [
    { "text": "82세 택시기사가 물게 된 4억 5천의 결말.", "img": 1 },
    { "text": "2014년 2월, 손님 태우러 신라호텔에 들어가던 모범택시가", "img": 1 },
    { "text": "호텔 정문 회전문을 그대로 들이받았음.", "img": 2 },
    { "text": "회전문은 완파됐고 직원과 투숙객 4명이 다쳤음.", "img": 2 },
    { "text": "기사님은 급발진을 주장했지만", "img": 3 },
    { "text": "경찰은 운전 부주의로 결론 내림.", "img": 3 },
    { "text": "피해액은 4억 5천만 원.", "em": ["4억 5천만 원"], "em_color": "yellow", "img": 4 },
    { "text": "근데 기사님 보험 한도는 5천만 원이 전부였음.", "em": ["5천만 원"], "img": 4 },
    { "text": "아니 그럼 나머지 4억은 어떻게 갚음?", "dialogue": true, "voice": "sub2", "img": 5 },
    { "text": "다들 그 걱정을 할 때, 보고받은 호텔 사장은", "img": 5 },
    { "text": "청구서보다 먼저 기사님 집을 찾아가 보라고 했음.", "img": 6 },
    { "text": "부사장이 이틀 뒤 찾아간 집은 허름한 반지하였고", "img": 6 },
    { "text": "기사님도 사고로 몸이 상한 데다", "img": 7 },
    { "text": "아내분은 뇌경색으로 쓰러져 치료비가 필요한 상황이었음.", "img": 7 },
    { "text": "사정을 들은 사장은 피해를 회사에서 처리하고", "img": 8 },
    { "text": "기사님한테는 한 푼도 청구하지 말라고 했음.", "em": ["한 푼도"], "img": 8 },
    { "text": "오히려 치료비를 지원하고", "img": 9 },
    { "text": "우족이랑 소고기, 케이크까지 들려 보냈다고 함.", "img": 9 },
    { "text": "그 사장이 신라호텔 이부진임.", "em": ["이부진"], "em_color": "yellow", "img": 10 },
    { "text": "12년이 지난 지금도 다시 회자되는 이유가 있는 거.", "emotion": "tonedown", "img": 11 },
    { "text": "구독!", "emotion": "toneup", "intensity": 2.0, "outro": true }
  ]
}
