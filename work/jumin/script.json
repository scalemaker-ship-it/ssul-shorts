  "title_line1": "등본 떼려다 막힌 사람",
  "title_line2": "누구 잘못임?",
  "hook": "신분증 없이 등본 떼려다 막혔는데 누구 잘못임?",
  "channel": "썰푸는휴지",
  "voice": "main",
  "style": {
    "sub_box": true,
    "bar": "직무유기하는 주민센터 직원 어디에 민원넣음?",
    "bar_count": 180
  },
  "lines": [
    {
      "text": "신분증 없이 등본 떼려다 막혔는데, 이거 누구 잘못임?",
      "img": 1
    },
    {
      "text": "지갑을 통째로 잃어버려서 신분증이 없었음.",
      "img": 2
    },
    {
      "text": "등본은 급한데 갔더니 신분증 없으면 안 된다고 잡아뗌.",
      "img": 4
    },
    {
      "text": "공무원 잘못이라는 쪽부터 보면,",
      "img": 4
    },
    {
      "text": "무인발급기는 신분증 없이 지문으로 등본이 나옴.",
      "em": [
        "지문"
      ],
      "em_color": "yellow",
      "img": 5
    },
    {
      "text": "그 기계가 같은 건물에 있었는데 한마디를 안 해줌.",
      "img": 6
    },
    {
      "text": "근데 반대쪽도 있음.",
      "img": 7
    },
    {
      "text": "아니 그걸 왜 못 찾음?",
      "dialogue": true,
      "img": 7
    },
    {
      "text": "무인발급기는 민원실에 웬만하면 다 있는 기계고,",
      "img": 7
    },
    {
      "text": "시행령까지 찾아낼 정신이면 기계부터 찾는 게 빨랐다는 거.",
      "img": 3
    },
    {
      "text": "그 직원은 나중에 전화해서 자기가 몰랐다고 사과했음.",
      "img": 9
    },
    {
      "text": "온 지 6개월도 안 됐고 등본 발급은 처음이었다고 함.",
      "em": [
        "6개월"
      ],
      "img": 10
    },
    {
      "text": "결국 안내를 안 한 개인 잘못이냐,",
      "img": 11
    },
    {
      "text": "이걸 안 가르친 쪽 문제냐 싸움인 거.",
      "emotion": "tonedown",
      "img": 11
    },
    {
      "text": "니들은 누구 잘못이라고 봄?",
      "img": 12
    },
    {
      "text": "구독!",
      "emotion": "toneup",
      "intensity": 2.0,
      "outro": true
    }
  ]
}