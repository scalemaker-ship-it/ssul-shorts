  "lines": [
    {
      "text": "길고양이 갈등이 절대 안 끝나는 이유?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "아파트 단지마다 이 싸움이 있음.",
      "img": 1
    },
    {
      "text": "한쪽은 불쌍하니까 밥을 주고",
      "img": 2
    },
    {
      "text": "한쪽은 냄새랑 소음 때문에 못 살겠다고 함.",
      "img": 2
    },
    {
      "text": "근데 이게 성격 싸움이 아님.",
      "img": 3
    },
    {
      "text": "구조가 그렇게 되어 있음.",
      "emotion": "tonedown",
      "img": 3
    },
    {
      "text": "밥을 주는 사람은 좋은 기분을 혼자 가져감.",
      "img": 4
    },
    {
      "text": "근데 그 결과인 냄새랑 소음은",
      "img": 4
    },
    {
      "text": "단지 전체가 나눠서 짊어짐.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "이런 걸 공유지의 비극이라고 하는데.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "이득은 개인이 갖고 비용은 모두가 나눠 내는 구조임.",
      "img": 6
    },
    {
      "text": "이러면 각자한테는 계속하는 게 이득이라",
      "img": 6
    },
    {
      "text": "아무도 멈출 이유가 없음.",
      "emotion": "tonedown",
      "img": 7
    },
    {
      "text": "그래서 설득으로는 안 끝남.",
      "emotion": "toneup",
      "img": 7
    },
    {
      "text": "실제로 갈등이 줄어든 곳들은",
      "img": 8
    },
    {
      "text": "급식소 위치를 정하고 중성화를 같이 했음.",
      "img": 8
    },
    {
      "text": "비용을 나눠 지는 방식으로 바꾼 거임.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "누가 나쁜 사람이라서 안 끝나는 게 아니라",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "계산서를 아무도 안 받아서 안 끝나는 거임.",
      "emotion": "tonedown",
      "img": 10
    }
  ]
}