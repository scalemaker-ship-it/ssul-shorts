  "hook": "친일파 후손들한테 곧 벌어질 일 ㄷㄷ",
  "channel": "썰푸는휴지",
  "lines": [
    { "text": "친일파 후손들한테 곧 벌어질 일?", "emotion": "toneup", "img": 1 },
    { "text": "일제강점기 때 나라 팔아넘긴 사람들이 있었음.", "img": 1 },
    { "text": "그 대가로 일본한테 땅을 받았음.", "img": 1 },
    { "text": "해방되고 80년이 지났는데", "img": 2 },
    { "text": "그 땅 아직도 후손들이 갖고 있음.", "emotion": "tonedown", "img": 2 },
    { "text": "물려받은 재산이라 법적으로는 문제없음.", "img": 3 },
    { "text": "그래서 아무도 못 건드렸음.", "emotion": "tonedown", "img": 3 },
    { "text": "근데 2005년에 법이 하나 생김.", "emotion": "toneup", "img": 4 },
    { "text": "친일 대가로 받은 재산은 국가 거라는 법.", "img": 4 },
    { "text": "친일재산 국가귀속 특별법.", "emotion": "toneup", "img": 4 },
    { "text": "이듬해 조사위원회가 꾸려져서", "img": 5 },
    { "text": "4년 동안 친일파 168명 땅을 뺏었음.", "img": 6 },
    { "text": "근데 여기서 다들 빠져나감.", "emotion": "tonedown", "img": 7 },
    { "text": "땅을 팔아버리면 뺏을 게 없어짐.", "img": 7 },
    { "text": "산 사람 땅까지 뺏을 순 없으니까.", "img": 7 },
    { "text": "후손들은 조사 들어오기 전에 팔았음.", "img": 8 },
    { "text": "통장에 남은 돈은 그대로 자기 거였음.", "emotion": "tonedown", "img": 9 },
    { "text": "조사위원회는 2010년에 문 닫았고", "img": 10 },
    { "text": "그러고 16년이 지났음.", "emotion": "tonedown", "img": 10 },
    { "text": "근데 올해 12월 3일", "emotion": "toneup", "img": 11 },
    { "text": "그 위원회가 다시 열림.", "emotion": "toneup", "img": 11 },
    { "text": "이번엔 판 돈까지 쫓아감.", "img": 11 },
    { "text": "진짜 문제는", "img": 12 },
    { "text": "80년 동안 이게 안 끝났다는 거.", "emotion": "tonedown", "img": 12 },
    { "text": "와... 광복 81년째에", "emotion": "tonedown", "img": 12 },
    { "text": "이제야 시작임.", "emotion": "tonedown", "img": 12 }
  ]
}
