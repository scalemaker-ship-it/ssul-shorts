  },
  "lines": [
    {
      "text": "리트리버 보고 맹견이라 우기던 아저씨가 있었음.",
      "img": 1
    },
    {
      "text": "저녁에 검은 리트리버를 산책시키는 중이었는데",
      "img": 1
    },
    {
      "text": "편의점 앞 부부가 너무 예쁘다며 쓰다듬어도 되냐고 물었음.",
      "img": 2
    },
    {
      "text": "그런데 옆에 있던 아저씨가 이러는 거임.",
      "img": 3
    },
    {
      "text": "검정 리트리버도 있네요. 리트리버는 맹견이죠?",
      "dialogue": true,
      "voice": "sub2",
      "img": 3
    },
    {
      "text": "견주는 당연히 아니라고 설명했음.",
      "img": 4
    },
    {
      "text": "안내견도 하고 탐색견도 하는, 사람 좋아하는 개라고.",
      "img": 4
    },
    {
      "text": "근데 아저씨가 또 이럼.",
      "img": 5
    },
    {
      "text": "아 그러니까 맹견이라구요!",
      "dialogue": true,
      "voice": "sub2",
      "img": 5
    },
    {
      "text": "설명을 해도 계속 맹견이 맞다고 하니까",
      "img": 6
    },
    {
      "text": "견주는 순간 화가 치밀어 올랐는데",
      "img": 6
    },
    {
      "text": "옆에 있던 아저씨 부인이 이렇게 말했음.",
      "img": 7
    },
    {
      "text": "미안해요, 이 사람이 경상도라 발음이 그래요!",
      "dialogue": true,
      "img": 7
    },
    {
      "text": "맹견이 아니라 명견이라고 한 거였음.",
      "em": [
        "명견"
      ],
      "em_color": "yellow",
      "img": 8
    },
    {
      "text": "주변 사람들까지 다 같이 웃고 끝난 거.",
      "emotion": "tonedown",
      "img": 8
    },
    {
      "text": "구독!",
      "emotion": "toneup",
      "intensity": 2.0,
      "outro": true
    }
  ]
}