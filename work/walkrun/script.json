  "title_line1": "서울대 의대 교수 왈",
  "title_line2": "걷기 2시간 = 달리기 1분?",
  "hook": "서울대 의대 교수 왈, 걷기 2시간 = 달리기 1분?",
  "channel": "법푸는휴지",
  "voice": "main",
  "style": {
    "sub_box": true,
    "bar": "'걷기 2시간 = 달리기 1분' 서울대 의대 교수의 말",
    "bar_count": 151
  },
  "lines": [
    {
      "text": "매일 30분씩 걷는 걸로 운동 다 했다고 생각하는 사람 많은데,",
      "img": 1
    },
    {
      "text": "서울대 의대 재활의학과 교수가 방송에서 이걸 뒤집는 말을 했음.",
      "img": 2
    },
    {
      "text": "걷기 같은 저강도 운동은 2시간을 해도,",
      "img": 3
    },
    {
      "text": "달리기 1분이랑 효과가 비슷하다는 거임.",
      "em": [
        "달리기 1분"
      ],
      "em_color": "yellow",
      "img": 4
    },
    {
      "text": "근데 이게 그냥 지나가는 사람 말이 아님.",
      "img": 5
    },
    {
      "text": "이 교수는 24년째 뛰고 있고,",
      "img": 6
    },
    {
      "text": "마라톤만 30번 넘게 완주했고 매일 10km씩 달림.",
      "em": [
        "30번"
      ],
      "img": 7
    },
    {
      "text": "심지어 길 위의 뇌라는 책까지 쓴 러닝 전문가임.",
      "img": 8
    },
    {
      "text": "여기서 핵심은 시간이 아니라 강도라는 거임.",
      "em": [
        "강도"
      ],
      "em_color": "yellow",
      "img": 9
    },
    {
      "text": "걷기는 오래 해도 심장이 크게 안 뛰는데,",
      "img": 10
    },
    {
      "text": "달리기는 짧아도 숨이 턱 끝까지 차오르니까,",
      "img": 11
    },
    {
      "text": "같은 시간을 써도 몸에 주는 자극이 완전히 다르다는 거.",
      "img": 12
    },
    {
      "text": "물론 무릎 약한 사람은 걷기부터가 맞고,",
      "img": 13
    },
    {
      "text": "뭐든 안 하는 것보단 백배 나음.",
      "img": 14
    },
    {
      "text": "근데 시간 없어서 운동 못 한다는 말은, 이제 핑계일 수도 있음.",
      "emotion": "tonedown",
      "img": 15
    },
    {
      "text": "님들은 걷기파임, 달리기파임?",
      "img": 15
    },
    {
      "text": "구독!",
      "emotion": "toneup",
      "intensity": 2.0,
      "outro": true,
      "img": 15
    }
  ]
}