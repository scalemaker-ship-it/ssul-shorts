  "lines": [
    {
      "text": "단골이 조용히 발길 끊는 순간?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "몇 년을 다니던 가게였음.",
      "img": 1
    },
    {
      "text": "사장님이랑 인사도 하고 서비스도 받았음.",
      "img": 2
    },
    {
      "text": "근데 어느 날 처음 온 손님한테",
      "img": 2
    },
    {
      "text": "내가 못 받아본 걸 주는 걸 봄.",
      "emotion": "tonedown",
      "img": 3
    },
    {
      "text": "그 순간부터 발길이 끊김.",
      "img": 3
    },
    {
      "text": "음식이 나빠진 것도 아닌데.",
      "emotion": "tonedown",
      "img": 4
    },
    {
      "text": "사람은 받은 양만 보는 게 아니라",
      "img": 4
    },
    {
      "text": "옆 사람이랑 비교해서 봄.",
      "img": 5
    },
    {
      "text": "이걸 형평성이라고 하는데.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "내가 손해 봤냐가 아니라 덜 대접받았냐가 기준이 됨.",
      "img": 6
    },
    {
      "text": "단골은 돈만 낸 게 아니라 시간도 낸 사람임.",
      "img": 6
    },
    {
      "text": "그래서 신규 혜택이 더 크면",
      "img": 7
    },
    {
      "text": "그동안의 시간이 값이 없어진 느낌이 듦.",
      "emotion": "tonedown",
      "img": 7
    },
    {
      "text": "근데 여기서 진짜 문제는 따로 있음.",
      "emotion": "toneup",
      "img": 8
    },
    {
      "text": "단골은 화를 내지 않고 그냥 사라짐.",
      "img": 8
    },
    {
      "text": "그래서 가게는 이유를 끝까지 모름.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "서운해서 떠난 게 아니라",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "말할 자리가 없어서 떠난 거임.",
      "emotion": "tonedown",
      "img": 10
    }
  ]
}