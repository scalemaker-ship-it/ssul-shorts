{
  "slug": "poortax",
  "type": "자극형 (C형/B형 변형)",
  "title_line1": "가난한 사람이",
  "title_line2": "더 비싸게 사는 구조",
  "hook": "가난한 사람이 더 비싸게 사는 구조 ㅎㄷㄷ",
  "channel": "썰푸는휴지",
  "voice": "minuk",
  "lines": [
    {
      "text": "가난한 사람이 더 비싸게 사는 구조?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "돈이 없으면 싸게 살 것 같은데 반대임.",
      "img": 1
    },
    {
      "text": "쌀을 20kg 사면 훨씬 싼 걸 알면서도",
      "img": 2
    },
    {
      "text": "당장 목돈이 없어서 소포장을 삼.",
      "img": 2
    },
    {
      "text": "그래서 1kg당 값은 더 비싸게 치름.",
      "emotion": "tonedown",
      "img": 3
    },
    {
      "text": "신발도 똑같음.",
      "img": 3
    },
    {
      "text": "10만 원짜리가 3년 가는 걸 알아도",
      "img": 4
    },
    {
      "text": "2만 원짜리를 사서 반년마다 바꿈.",
      "img": 4
    },
    {
      "text": "결국 3년 동안 12만 원을 씀.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "이걸 빈곤 프리미엄이라고 하는데.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "가난할수록 같은 물건에 더 많은 돈을 내는 현상임.",
      "img": 6
    },
    {
      "text": "대출도 그럼.",
      "emotion": "toneup",
      "img": 6
    },
    {
      "text": "신용이 낮으면 금리가 높게 붙고",
      "img": 7
    },
    {
      "text": "높은 금리를 갚느라 신용이 더 떨어짐.",
      "img": 7
    },
    {
      "text": "월세도 그럼.",
      "img": 8
    },
    {
      "text": "보증금이 없으면 달마다 내는 돈이 올라가고",
      "img": 8
    },
    {
      "text": "올라간 월세 때문에 보증금을 못 모음.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "그래서 가난은 게으름의 결과가 아니라",
      "img": 9
    },
    {
      "text": "한 번 들어가면 나오는 문이 좁은 구조임.",
      "emotion": "tonedown",
      "img": 10
    },
    {
      "text": "돈이 없어서 손해 본 적, 다들 하나쯤 있음.",
      "emotion": "tonedown",
      "img": 10
    }
  ]
}