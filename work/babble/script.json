{
  "slug": "babble",
  "type": "자극형 (C형/B형 변형)",
  "title_line1": "회의에서 말 많은 사람이",
  "title_line2": "리더가 되는 이유",
  "hook": "회의에서 말 많은 사람이 리더가 되는 이유 ㅎㄷㄷ",
  "channel": "썰푸는휴지",
  "voice": "minuk",
  "lines": [
    {
      "text": "회의에서 말 많은 사람이 리더가 되는 이유?",
      "emotion": "toneup",
      "img": 1
    },
    {
      "text": "회의 끝나고 이런 생각 든 적 있음.",
      "img": 1
    },
    {
      "text": "저 사람 말은 많은데 알맹이는 없었는데.",
      "img": 2
    },
    {
      "text": "근데 왜 다들 저 사람을 따라가지.",
      "emotion": "tonedown",
      "img": 2
    },
    {
      "text": "연구자들이 이걸 실제로 재봤음.",
      "img": 3
    },
    {
      "text": "처음 만난 사람들을 조로 묶어서 과제를 주고",
      "img": 3
    },
    {
      "text": "누가 리더처럼 보였는지 물어봤음.",
      "img": 4
    },
    {
      "text": "지능도 재고 성격도 쟀는데",
      "img": 4
    },
    {
      "text": "리더로 뽑히는 걸 가장 잘 맞힌 건 말한 양이었음.",
      "emotion": "toneup",
      "img": 5
    },
    {
      "text": "내용의 질이 아니라 그냥 분량이었음.",
      "emotion": "tonedown",
      "img": 5
    },
    {
      "text": "이걸 배블 효과라고 하는데.",
      "emotion": "tonedown",
      "img": 6
    },
    {
      "text": "말이 많으면 자신 있어 보이고",
      "img": 6
    },
    {
      "text": "자신 있어 보이면 아는 것처럼 보임.",
      "img": 7
    },
    {
      "text": "듣는 사람은 내용을 다 검증할 수가 없으니까",
      "img": 7
    },
    {
      "text": "말한 양을 능력의 대용품으로 씀.",
      "emotion": "tonedown",
      "img": 8
    },
    {
      "text": "그래서 회의에서 조용히 있으면",
      "img": 8
    },
    {
      "text": "생각이 깊은 게 아니라 없는 걸로 읽힘.",
      "emotion": "tonedown",
      "img": 9
    },
    {
      "text": "억울하면 짧게라도 먼저 말을 꺼내야 함.",
      "img": 9
    },
    {
      "text": "실력으로 뽑히는 게 아니라",
      "emotion": "tonedown",
      "img": 10
    },
    {
      "text": "보이는 사람 중에서 뽑히기 때문임.",
      "emotion": "tonedown",
      "img": 10
    }
  ]
}